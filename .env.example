# Copy to .env. Every application variable is prefixed NEXUS_. NEVER commit .env.
# --- required for docker compose ---
NEXUS_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=nexus-minio
MINIO_ROOT_PASSWORD=change-me-too

# --- models (default: offline mock components; results with them are plumbing-only, see docs/evaluation.md) ---
NEXUS_LLM_PROVIDER=mock                 # mock | openai | anthropic
NEXUS_LLM_MODEL=mock-llm
NEXUS_LLM_API_KEY=
NEXUS_EMBEDDING_PROVIDER=mock           # mock | sentence_transformers | openai
NEXUS_EMBEDDING_MODEL=hashing-v1
NEXUS_EMBEDDING_DIM=384                 # must match the model; changing it requires re-ingesting documents
NEXUS_EMBEDDING_API_KEY=

# --- optional observability ---
# Multimodal (Phase 11). OCR needs the tesseract binary (installed in the backend image).
NEXUS_MULTIMODAL_ENABLED=true
NEXUS_IMAGE_OCR_ENABLED=true
NEXUS_VISION_PROVIDER=none              # none | mock | openai | anthropic  (a real provider sends image bytes to that provider)
NEXUS_VISION_MODEL=gpt-4o-mini
NEXUS_VISION_API_KEY=
# Connectors (Phase 12)
NEXUS_CONNECTOR_SECRET_KEY=             # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_CONNECTOR_DNS_CHECK=true
NEXUS_CONNECTOR_MAX_ITEMS_PER_SYNC=500
# Autonomous agents (Phase 13)
NEXUS_AGENTIC_MAX_WAVES=3
NEXUS_AGENTIC_MAX_STEPS=12
NEXUS_AGENTIC_CODE_EXECUTION_ENABLED=false   # read docs/agentic.md first: run behind container isolation
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_ENDPOINT=                    # e.g. http://otel-collector:4318/v1/traces (needs backend/requirements-otel.txt in the image)
NEXUS_LANGSMITH_ENABLED=false           # also set LANGSMITH_API_KEY

# --- local (non-docker) development ---
# NEXUS_ENV=dev
# NEXUS_DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# --- LLMOps (docs/llmops.md) ---
# NEXUS_LLM_ROUTING_CONFIG={"models":{...},"default_chain":[...]}   # or @/path/routing.json; keys come from env vars it names
NEXUS_LLM_PRICE_IN_PER_MTOK=0
NEXUS_LLM_PRICE_OUT_PER_MTOK=0
NEXUS_LLM_CACHE_ENABLED=false     # exact-match, per-tenant; leave off for evaluation runs
NEXUS_LLM_CACHE_TTL_SECONDS=3600
NEXUS_LLM_CACHE_MAX_ENTRIES=2000
NEXUS_LLM_USAGE_FLUSH_SECONDS=2

# --- Distributed operation (docs/deployment-kubernetes.md) ---
# NEXUS_REDIS_URL is REQUIRED with more than one API replica (rate limits, leases, event bus).
NEXUS_LEASE_TTL_SECONDS=60
NEXUS_QUEUE_GAUGE_SECONDS=10
NEXUS_WORKER_HEARTBEAT_PATH=/tmp/nexus-worker-heartbeat
NEXUS_WORKER_HEARTBEAT_SECONDS=15

# --- Continuous learning (docs/learning.md) ---
NEXUS_QUALITY_MONITOR_INTERVAL_SECONDS=3600   # 0 disables the background monitor

# --- Release / DR tooling (no application settings) ---
# infrastructure/scripts/backup.py uses NEXUS_DATABASE_URL (or --dsn) and PG_BIN (directory with pg_dump/pg_restore/psql) if they are not on PATH.
